{
  "expo": {
    "name": "Khadamat OS",
    "slug": "khadamat-os",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ae.khadamatco.os",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of bills, rooms, bins and checkpoints for Khadamat OS records.",
        "NSPhotoLibraryUsageDescription": "Attach photos to Khadamat OS records.",
        "NSMicrophoneUsageDescription": "Record voice notes for camp reports.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.khadamat.os",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications"
    ]
  }
}